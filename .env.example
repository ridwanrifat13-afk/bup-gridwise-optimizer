# =====================================================================
# GridWise LLM Energy Optimizer Environment Configuration
# =====================================================================
# Primary LLM Provider: NVIDIA Nemotron 3 Ultra (via OpenRouter API)
# Get your API key at: https://openrouter.ai/keys
# Set this key in your local .env or in Vercel Project Environment Variables.
OPENROUTER_API_KEY=

# Model configuration (NVIDIA Nemotron 3 Ultra 550B)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REASONING_EFFORT=none

# Timeout and budget settings (seconds)
LLM_TIMEOUT_SECONDS=15
LLM_TOTAL_BUDGET_SECONDS=25
LOG_LEVEL=INFO

# Optional legacy fallback: Google Gemini (if OPENROUTER_API_KEY is omitted)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
